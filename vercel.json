{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "style.css",
          "app.js",
          "anuj.jpg",
          "hat_filled.png",
          "pamphlet*.html",
          "images/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/server.js"
    },
    {
      "src": "/pamphlet1",
      "dest": "/pamphlet1_aurora_glass.html"
    },
    {
      "src": "/pamphlet2",
      "dest": "/pamphlet2_neo_brutalism.html"
    },
    {
      "src": "/pamphlet3",
      "dest": "/pamphlet3_japanese_zen.html"
    },
    {
      "src": "/pamphlet4",
      "dest": "/pamphlet4_cybernetic_holo.html"
    },
    {
      "src": "/pamphlet5",
      "dest": "/pamphlet5_retro_risograph.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

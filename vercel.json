{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "style.css",
          "app.js",
          "anuj.jpg",
          "mehek.jpg",
          "hat_*.png",
          "pamphlet*.html"
        ]
      }
    },
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "api/chat.js"
    },
    {
      "src": "/pamphlet1",
      "dest": "server.js"
    },
    {
      "src": "/pamphlet2",
      "dest": "server.js"
    },
    {
      "src": "/pamphlet3",
      "dest": "server.js"
    },
    {
      "src": "/pamphlet4",
      "dest": "server.js"
    },
    {
      "src": "/pamphlet5",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
